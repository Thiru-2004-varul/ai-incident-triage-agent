# Copy this file to .env and fill in your values
# Never commit .env to GitHub

# Anthropic API key (get free at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Jira Cloud (free plan at atlassian.com)
# Your domain: https://YOUR_DOMAIN.atlassian.net
JIRA_DOMAIN=your-domain
JIRA_EMAIL=your@email.com
# Generate at: https://id.atlassian.net/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=OPS

# Slack (free incoming webhook)
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#incidents
